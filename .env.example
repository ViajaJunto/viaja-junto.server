# Aplicacao
PORT=3000
NODE_ENV=development
API_PREFIX=api

# Prisma / PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/viajajunto?schema=public"

# Google OAuth — Google Cloud Console > APIs & Services > Credentials.
# The callback URL must be registered as an "Authorized redirect URI".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Frontend page that receives the access token after sign-in.
AUTH_REDIRECT_URL=http://localhost:5173/auth/callback

# JWT — generate with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=3600

# Object storage (S3) — optional. Without S3_BUCKET photo uploads answer 503.
# To use the MiniStack bucket from `npm run start:dev`, after `npm run aws:deploy`:
#   S3_BUCKET=viajajunto-photos-000000000000
#   S3_ENDPOINT=http://localhost:4566
#   S3_FORCE_PATH_STYLE=true
#   AWS_ACCESS_KEY_ID=test
#   AWS_SECRET_ACCESS_KEY=test
AWS_REGION=us-east-1
S3_BUCKET=
S3_ENDPOINT=
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=

# Docker Compose (devem bater com a DATABASE_URL acima)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=viajajunto
POSTGRES_PORT=5432
ADMINER_PORT=8080

# Porta exposta pela API quando ela roda via docker compose
API_PORT=3000
