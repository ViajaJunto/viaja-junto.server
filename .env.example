# Aplicacao
PORT=3000
NODE_ENV=development
API_PREFIX=api

# Prisma / PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/viajajunto?schema=public"

# Google OAuth — Google Cloud Console > APIs & Services > Credentials.
# The callback URL must be registered as an "Authorized redirect URI".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Frontend page that receives the access token after sign-in.
AUTH_REDIRECT_URL=http://localhost:5173/auth/callback

# Browser origins allowed to call the API (CORS), comma-separated, no trailing slash.
CORS_ORIGINS=http://localhost:5173

# Rate limiting: requests allowed per client IP in each window (seconds).
# THROTTLE_TTL_SECONDS=60
# THROTTLE_LIMIT=300          # reads
# THROTTLE_WRITE_LIMIT=60     # POST / PATCH / PUT / DELETE
# THROTTLE_STRICT_LIMIT=10    # sign-in, joining with a code, uploads, reviews, places
# Reverse proxies in front of the API (e.g. 1 behind a load balancer) so the
# client IP is read from X-Forwarded-For. Leave 0 when clients connect directly.
# TRUST_PROXY_HOPS=0

# JWT — generate with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=3600
# Rotating JWT_SECRET without signing everyone out: put the OLD secret here and
# the new one in JWT_SECRET. New tokens are signed with the new secret; tokens
# signed with the old one stay valid until they expire. Remove it after
# JWT_EXPIRES_IN seconds.
# JWT_SECRET_PREVIOUS=

# External places (OpenStreetMap / Nominatim) — optional. Without PLACES_USER_AGENT
# the places endpoints answer 503. Nominatim's usage policy requires a User-Agent
# that identifies the application and a way to contact you.
# PLACES_USER_AGENT=ViajaJunto/1.0 (you@example.com)
# PLACES_BASE_URL=https://nominatim.openstreetmap.org
# PLACES_TIMEOUT_MS=5000

# Object storage (S3) — optional. Without S3_BUCKET photo uploads answer 503.
# To use the MiniStack bucket from `npm run start:dev`, after `npm run aws:deploy`:
#   S3_BUCKET=viajajunto-photos-000000000000
#   S3_ENDPOINT=http://localhost:4566
#   S3_FORCE_PATH_STYLE=true
#   AWS_ACCESS_KEY_ID=test
#   AWS_SECRET_ACCESS_KEY=test
AWS_REGION=us-east-1
S3_BUCKET=
S3_ENDPOINT=
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=

# Docker Compose (devem bater com a DATABASE_URL acima)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=viajajunto
POSTGRES_PORT=5432
ADMINER_PORT=8080

# Porta exposta pela API quando ela roda via docker compose
API_PORT=3000
